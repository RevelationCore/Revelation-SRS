{
  "name": "@revelation-srs/api",
  "version": "0.0.1",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsx watch --env-file=../../.env src/main.ts",
    "start": "node dist/main.js",
    "worker": "tsx --env-file=../../.env src/worker.ts",
    "start:worker": "node dist/worker.js",
    "workflow:smoke": "tsx --env-file=../../.env scripts/workflow-smoke.ts",
    "test": "vitest run --reporter=verbose",
    "test:int": "vitest run --reporter=verbose --config vitest.int.config.ts --passWithNoTests",
    "test:watch": "vitest --reporter=verbose",
    "generate:openapi": "tsx scripts/generate-openapi.ts",
    "generate:compat-report": "tsx scripts/generate-compat-report.ts"
  },
  "dependencies": {
    "@fastify/cors": "^10.1.0",
    "@fastify/helmet": "^12.0.1",
    "@fastify/jwt": "^10.2.8",
    "@fastify/multipart": "^9.4.0",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/swagger": "^9.9.4",
    "@fastify/swagger-ui": "^6.1.4",
    "@opentelemetry/api": "~1.9.1",
    "@opentelemetry/auto-instrumentations-node": "^0.81.2",
    "@opentelemetry/exporter-trace-otlp-http": "^0.223.2",
    "@opentelemetry/resources": "^2.12.1",
    "@opentelemetry/sdk-node": "^0.223.2",
    "@opentelemetry/sdk-trace-node": "^2.12.1",
    "@opentelemetry/semantic-conventions": "^1.45.0",
    "@revelation-srs/auth": "workspace:*",
    "@revelation-srs/db": "workspace:*",
    "@revelation-srs/documents": "workspace:*",
    "@revelation-srs/domain": "workspace:*",
    "@revelation-srs/workflow": "workspace:*",
    "@sinclair/typebox": "^0.34.52",
    "@temporalio/client": "1.25.0",
    "@temporalio/worker": "1.25.0",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.8",
    "fastify-plugin": "^5.1.0",
    "nats": "^2.29.3",
    "pdfmake": "0.2.23",
    "pino": "^9.14.0"
  },
  "devDependencies": {
    "@revelation-srs/testing": "workspace:*",
    "@temporalio/testing": "1.25.0",
    "@testcontainers/postgresql": "^12.2.1",
    "@types/node": "^22.20.5",
    "@types/pdfmake": "0.2.12",
    "@vitest/coverage-istanbul": "^4.1.12",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "pino-pretty": "^13.2.0",
    "testcontainers": "^12.2.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^4.1.12"
  }
}
