{
  "name": "@revelation-srs/api",
  "version": "0.0.1",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "test": "vitest run --reporter=verbose",
    "test:int": "vitest run --reporter=verbose --config vitest.int.config.ts --passWithNoTests",
    "test:watch": "vitest --reporter=verbose",
    "generate:openapi": "tsx scripts/generate-openapi.ts",
    "generate:compat-report": "tsx scripts/generate-compat-report.ts"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.0",
    "@fastify/helmet": "^12.0.0",
    "@fastify/jwt": "^9.0.0",
    "@fastify/rate-limit": "^10.0.0",
    "@fastify/swagger": "^9.0.0",
    "@fastify/swagger-ui": "^5.0.0",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/auto-instrumentations-node": "^0.46.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.52.0",
    "@opentelemetry/resources": "^1.25.0",
    "@opentelemetry/sdk-node": "^0.52.0",
    "@opentelemetry/sdk-trace-node": "^1.25.0",
    "@opentelemetry/semantic-conventions": "^1.25.0",
    "@revelation-srs/auth": "workspace:*",
    "@revelation-srs/db": "workspace:*",
    "@revelation-srs/domain": "workspace:*",
    "@revelation-srs/workflow": "workspace:*",
    "@sinclair/typebox": "^0.34.0",
    "drizzle-orm": "^0.36.0",
    "fastify": "^5.0.0",
    "fastify-plugin": "^5.0.0",
    "nats": "^2.26.0",
    "pino": "^9.0.0"
  },
  "devDependencies": {
    "@revelation-srs/testing": "workspace:*",
    "@testcontainers/postgresql": "^12.0.1",
    "@types/node": "^22.0.0",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "pino-pretty": "^13.1.3",
    "testcontainers": "^10.0.0",
    "tsx": "^4.0.0",
    "typescript": "^6.0.0",
    "vitest": "^2.0.0"
  }
}
