# API base URL — must match the running SRS API
VITE_API_BASE_URL=http://localhost:3000

# Wellbeing module API base URL — a separate deployable service (own
# database, own auth check) that this app talks to directly for
# adjustment-case workflow (referral/assessment/panel/approve/reject)
VITE_WELLBEING_API_URL=http://localhost:3002

# Enable demo mode banner (shows scenario name, demo date, and reset schedule)
VITE_DEMO_MODE=true

# Keycloak OIDC — comment out all three to fall back to JWT-paste mode
VITE_KEYCLOAK_URL=http://localhost:8081
VITE_KEYCLOAK_REALM=srs
VITE_KEYCLOAK_CLIENT_ID=srs-admin
