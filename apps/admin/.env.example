# The app calls only its own origin (ADR-026): /bff/* is proxied to this
# app's backend-for-frontend, which holds the tokens and calls the API and
# the wellbeing module. In development the Vite server proxies /bff to the
# BFF on port 3010 (apps/bff, `pnpm dev`).

# Enable demo mode banner (shows scenario name, demo date, and reset schedule)
VITE_DEMO_MODE=true

# Single sign-on through the BFF and Keycloak; set to false to hide it.
VITE_SSO=true
