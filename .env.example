# ── Database ─────────────────────────────────────────────────────────────────
# Services connect as srs_api, which inherits srs_app: row-level security
# applies to every query. Migrations and the demo loader use the owner.
# (infra/compose/init/02-app-role.sql creates srs_api on a fresh volume.)
DATABASE_URL=postgres://srs_api:srs_api@localhost:5432/srs
MIGRATION_DATABASE_URL=postgres://srs:srs@localhost:5432/srs

# ── NATS ──────────────────────────────────────────────────────────────────────
NATS_URL=nats://localhost:4222

# ── Temporal ──────────────────────────────────────────────────────────────────
TEMPORAL_ADDRESS=localhost:7233

# ── Authentication ────────────────────────────────────────────────────────────
# For local development only — use Keycloak JWKS in staging/production
JWT_SECRET=change-me-in-production-use-keycloak-jwks
# Keycloak JWKS endpoint — enables RS256 token validation; overrides JWT_SECRET.
# Uncomment to use the local Keycloak container (docker compose up):
# KEYCLOAK_JWKS_URL=http://localhost:8081/realms/srs/protocol/openid-connect/certs
# Tokens must come from this issuer (default: the realm the JWKS URL sits under)
# and name the service in `aud` (default srs-api / srs-wellbeing / srs-attendance).
# KEYCLOAK_ISSUER=http://localhost:8081/realms/srs
# KEYCLOAK_AUDIENCE=srs-api
# JWT_CLOCK_TOLERANCE_SECONDS=30
# Outside NODE_ENV=development or test the services refuse to start without
# KEYCLOAK_JWKS_URL: JWT_SECRET (HS256) is for development and test only.

# ── Application ───────────────────────────────────────────────────────────────
PORT=3000
LOG_LEVEL=info
NODE_ENV=development
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
# Proxies whose X-Forwarded-For is believed (addresses, CIDRs or uniquelocal).
# Unset locally; Kubernetes sets uniquelocal for the ingress.
# TRUST_PROXY=uniquelocal

# ── OpenTelemetry ─────────────────────────────────────────────────────────────
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=srs-api

# ── Email ─────────────────────────────────────────────────────────────────────
# Only the fake mail server ships: outbound mail goes to its mailboxes
# (admin → Operations → Email simulator), never to a real inbox.
EMAIL_TRANSPORT=fake
EMAIL_FROM_ADDRESS=registry@revelation.example.ac.uk
