# ── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgres://srs:srs@localhost:5432/srs

# ── NATS ──────────────────────────────────────────────────────────────────────
NATS_URL=nats://localhost:4222

# ── Temporal ──────────────────────────────────────────────────────────────────
TEMPORAL_ADDRESS=localhost:7233

# ── Authentication ────────────────────────────────────────────────────────────
# For local development only — use Keycloak JWKS in staging/production
JWT_SECRET=change-me-in-production-use-keycloak-jwks
# Keycloak JWKS endpoint (set in staging/production; overrides JWT_SECRET)
# KEYCLOAK_JWKS_URL=http://keycloak:8081/realms/srs-dev/protocol/openid-connect/certs

# ── Application ───────────────────────────────────────────────────────────────
PORT=3000
LOG_LEVEL=info
NODE_ENV=development
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# ── OpenTelemetry ─────────────────────────────────────────────────────────────
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=srs-api
