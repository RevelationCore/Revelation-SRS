{
  "name": "@revelation-srs/vle-connector",
  "version": "0.0.1",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsx watch --env-file=../../.env src/main.ts",
    "start": "node dist/main.js",
    "test": "vitest run --reporter=verbose",
    "test:int": "vitest run --reporter=verbose --config vitest.int.config.ts --passWithNoTests",
    "test:watch": "vitest --reporter=verbose",
    "migrate": "tsx --env-file-if-exists=../../.env src/db/migrate.ts"
  },
  "dependencies": {
    "@fastify/cors": "^10.1.0",
    "@fastify/helmet": "^12.0.1",
    "@revelation-srs/service-client": "workspace:*",
    "@revelation-srs/telemetry": "workspace:*",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.8",
    "nats": "^2.29.3",
    "pino": "^9.14.0",
    "postgres": "^3.4.9"
  },
  "devDependencies": {
    "@revelation-srs/domain": "workspace:*",
    "@testcontainers/postgresql": "^12.2.1",
    "@types/node": "^22.20.5",
    "pino-pretty": "^13.2.0",
    "testcontainers": "^12.2.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^4.1.12"
  }
}
