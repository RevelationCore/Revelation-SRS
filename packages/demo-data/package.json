{
  "name": "@revelation-srs/demo-data",
  "version": "0.0.1",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "typecheck":           "tsc -p tsconfig.json --noEmit",
    "build":               "tsc -p tsconfig.json",
    "test":                "vitest run --reporter=verbose --config vitest.config.ts",
    "test:golden":         "vitest run --reporter=verbose --config vitest.int.config.ts",
    "demo:list":           "node --env-file-if-exists=../../.env --env-file-if-exists=.env --import tsx/esm src/cli.ts list",
    "demo:reset":          "DEMO_DATA_ENABLED=true DEMO_RESET_ALLOWED=true node --env-file-if-exists=../../.env --env-file-if-exists=.env --import tsx/esm src/cli.ts reset",
    "demo:validate":       "DEMO_DATA_ENABLED=true node --env-file-if-exists=../../.env --env-file-if-exists=.env --import tsx/esm src/cli.ts validate",
    "demo:status":         "node --env-file-if-exists=../../.env --env-file-if-exists=.env --import tsx/esm src/cli.ts status",
    "demo:check-versions": "node --env-file-if-exists=../../.env --env-file-if-exists=.env --import tsx/esm src/cli.ts check-versions",
    "demo:rotate":         "DEMO_DATA_ENABLED=true DEMO_RESET_ALLOWED=true node --env-file-if-exists=../../.env --env-file-if-exists=.env --import tsx/esm src/cli.ts rotate",
    "setup:keycloak":      "node --env-file-if-exists=../../.env --env-file-if-exists=.env --import tsx/esm src/cli.ts setup-keycloak"
  },
  "dependencies": {
    "@revelation-srs/db": "workspace:*",
    "drizzle-orm": "^0.36.0"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^12.0.1",
    "@types/node": "^22.0.0",
    "testcontainers": "^10.0.0",
    "tsx": "^4.0.0",
    "typescript": "^6.0.0",
    "vitest": "^2.0.0"
  }
}
