{
  "name": "@revelation-srs/demo-data",
  "version": "0.0.1",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "typecheck":           "tsc -p tsconfig.json --noEmit",
    "build":               "tsc -p tsconfig.json",
    "test":                "vitest run --reporter=verbose --config vitest.config.ts",
    "test:golden":         "vitest run --reporter=verbose --config vitest.int.config.ts",
    "demo:list":           "node --import tsx/esm src/cli.ts list",
    "demo:reset":          "node --import tsx/esm src/cli.ts reset",
    "demo:validate":       "node --import tsx/esm src/cli.ts validate",
    "demo:status":         "node --import tsx/esm src/cli.ts status",
    "demo:check-versions": "node --import tsx/esm src/cli.ts check-versions",
    "demo:rotate":         "node --import tsx/esm src/cli.ts rotate"
  },
  "dependencies": {
    "@revelation-srs/db": "workspace:*",
    "drizzle-orm": "^0.36.0"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^12.0.1",
    "@types/node": "^22.0.0",
    "testcontainers": "^10.0.0",
    "tsx": "^4.0.0",
    "typescript": "^6.0.0",
    "vitest": "^2.0.0"
  }
}
