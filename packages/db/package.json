{
  "name": "@revelation-srs/db",
  "version": "0.0.1",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsc -p tsconfig.json --watch",
    "generate": "drizzle-kit generate",
    "migrate": "node --env-file-if-exists=../../.env --import tsx/esm src/migrate.ts",
    "seed:dev": "node --env-file-if-exists=../../.env --import tsx/esm src/seed-dev.ts",
    "test": "vitest run --reporter=verbose",
    "test:int": "vitest run --reporter=verbose --config vitest.int.config.ts"
  },
  "dependencies": {
    "@revelation-srs/documents": "workspace:*",
    "drizzle-orm": "^0.45.4",
    "postgres": "^3.4.9"
  },
  "devDependencies": {
    "@revelation-srs/domain": "workspace:*",
    "@testcontainers/postgresql": "^12.2.1",
    "@types/node": "^22.20.5",
    "drizzle-kit": "^0.31.11",
    "testcontainers": "^12.2.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^4.1.12"
  }
}
