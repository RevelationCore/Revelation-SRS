{
  "name": "revelation-srs",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "description": "Open source Student Records System for UK Higher Education",
  "license": "AGPL-3.0-or-later",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "pnpm test:unit",
    "test:unit": "node scripts/run-test-class.mjs unit",
    "test:component": "node scripts/run-test-class.mjs component",
    "test:quick": "node scripts/run-test-class.mjs quick",
    "test:int": "pnpm test:service",
    "test:service": "node scripts/run-test-class.mjs service",
    "dev": "pnpm --parallel -r dev",
    "generate:types": "openapi-typescript apps/api/openapi/v1.json -o packages/ui/src/api/v1.gen.ts",
    "check:types-drift": "openapi-typescript apps/api/openapi/v1.json -o packages/ui/src/api/v1.gen.ts && git diff --exit-code packages/ui/src/api/v1.gen.ts",
    "test:e2e": "node scripts/deprecated-test-e2e.mjs",
    "test:ui:mocked": "node scripts/run-mocked-ui.mjs",
    "test:journey": "node scripts/run-real-journey.mjs",
    "test:uat": "playwright test uat/remaining-stories.spec.ts",
    "test:capability": "node scripts/select-journeys.mjs capability",
    "test:persona": "node scripts/select-journeys.mjs persona",
    "test:all": "node scripts/run-test-class.mjs all",
    "test:preflight": "node scripts/environment.mjs preflight",
    "check:bundle-size": "node scripts/check-bundle-size.mjs",
    "generate:business-process-docs": "node scripts/generate-remaining-business-process-docs.mjs",
    "check:business-process-docs": "node scripts/check-business-process-docs.mjs",
    "check:p0-business-process-requirements": "node scripts/check-p0-business-process-requirements.mjs",
    "check:business-process-data-model": "node scripts/check-business-process-data-model.mjs",
    "check:current-capabilities": "node scripts/check-current-capabilities.mjs",
    "check:journey-metadata": "node scripts/select-journeys.mjs validate",
    "evidence:generate": "node scripts/generate-evidence-report.mjs",
    "check:doc-links": "node scripts/check-doc-links.mjs",
    "check:attendance-increment-a": "node scripts/check-attendance-increment-a.mjs",
    "check:attendance-increment-b": "node scripts/check-attendance-increment-b.mjs",
    "check:attendance-increment-c": "node scripts/check-attendance-increment-c.mjs",
    "check:attendance-increment-d": "node scripts/check-attendance-increment-d.mjs",
    "check:attendance-increment-e": "node scripts/check-attendance-increment-e.mjs",
    "check:attendance-increment-f": "node scripts/check-attendance-increment-f.mjs",
    "check:attendance-increment-g": "node scripts/check-attendance-increment-g.mjs",
    "migrate": "pnpm --filter @revelation-srs/db migrate && pnpm --filter @revelation-srs/wellbeing migrate && pnpm --filter @revelation-srs/attendance migrate && pnpm --filter @revelation-srs/vle-connector migrate",
    "migrate:gen": "pnpm --filter @revelation-srs/db generate",
    "demo:list": "pnpm --filter @revelation-srs/demo-data demo:list",
    "demo:reset": "pnpm --filter @revelation-srs/demo-data demo:reset",
    "demo:validate": "pnpm --filter @revelation-srs/demo-data demo:validate",
    "demo:status": "pnpm --filter @revelation-srs/demo-data demo:status",
    "demo:check-versions": "pnpm --filter @revelation-srs/demo-data demo:check-versions",
    "demo:rotate": "pnpm --filter @revelation-srs/demo-data demo:rotate",
    "evaluate": "node scripts/evaluate.mjs start",
    "evaluate:status": "node scripts/evaluate.mjs status",
    "evaluate:reset": "node scripts/evaluate.mjs reset",
    "evaluate:stop": "node scripts/evaluate.mjs stop",
    "test:e2e:golden": "pnpm --filter @revelation-srs/demo-data test:golden",
    "test:e2e:playwright:golden": "playwright test --config playwright.golden.config.ts",
    "setup:keycloak": "pnpm --filter @revelation-srs/demo-data setup:keycloak",
    "tutorial:analyse": "node tutorials/scripts/print-analysis.mjs",
    "tutorial:test": "node tutorials/setup/prepare-tutorial-data.mjs && node tutorials/setup/ensure-app-running.mjs && TUTORIAL_FAST=1 playwright test --config=tutorials/playwright.config.ts",
    "tutorial:record": "node tutorials/setup/prepare-tutorial-data.mjs && node tutorials/setup/ensure-app-running.mjs && playwright test --config=tutorials/playwright.config.ts",
    "tutorial:narrate": "node tutorials/scripts/generate-narration.mjs",
    "tutorial:build": "node tutorials/scripts/build-overview-video.mjs",
    "tutorial:check": "node tutorials/scripts/quality-check.mjs",
    "tutorial:all": "node tutorials/scripts/run-all.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@eslint/js": "^9.0.0",
    "@playwright/test": "^1.61.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@testing-library/user-event": "^14.6.1",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "axe-core": "^4.13.0",
    "bundlesize": "^0.18.2",
    "eslint": "^9.0.0",
    "eslint-plugin-import-x": "^4.0.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0",
    "jest-axe": "^11.0.0",
    "jsdom": "^26.0.0",
    "msw": "^2.7.0",
    "openapi-typescript": "^7.13.0",
    "typescript": "^6.0.3",
    "vitest": "^2.1.9"
  },
  "pnpm": {
    "overrides": {
      "typescript": "^6.0.0"
    }
  }
}
