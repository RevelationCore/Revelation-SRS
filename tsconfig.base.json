{
  "compilerOptions": {
    "target":                          "ES2022",
    "module":                          "Node16",
    "moduleResolution":                "Node16",
    "lib":                             ["ES2022"],
    "strict":                          true,
    "exactOptionalPropertyTypes":      true,
    "noUncheckedIndexedAccess":        true,
    "noImplicitOverride":              true,
    "declaration":                     true,
    "declarationMap":                  true,
    "sourceMap":                       true,
    "esModuleInterop":                 true,
    "resolveJsonModule":               true,
    "baseUrl":                         ".",
    "paths": {
      "@revelation-srs/auth":   ["packages/auth/src/index.ts"],
      "@revelation-srs/db":     ["packages/db/src/index.ts"],
      "@revelation-srs/domain": ["packages/domain/src/index.ts"],
      "@revelation-srs/testing":["packages/testing/src/index.ts"],
      "@revelation-srs/workflow":["packages/workflow/src/index.ts"]
    },
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck":                    true
  }
}
