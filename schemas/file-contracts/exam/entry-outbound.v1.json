{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://schemas.revelation-srs.io/file-contracts/exam/entry-outbound/v1.json",
  "title": "ExamEntryOutboundV1",
  "description": "Outbound exam entry batch generated by POST /api/v1/exam-boards/{boardId}/exam-entries/generate. Contains one record per module registration that has been registered for a formal exam. Transmitted to the exam scheduling system so that candidate numbers, seat assignments, and timetable slots can be assigned.",
  "type": "object",
  "required": [
    "entryCount",
    "entries"
  ],
  "additionalProperties": false,
  "properties": {
    "entryCount": {
      "type": "integer",
      "minimum": 0,
      "description": "Number of exam entry records in this batch."
    },
    "entries": {
      "type": "array",
      "description": "Exam entry records to transmit to the exam scheduling system.",
      "items": {
        "$ref": "#/definitions/ExamEntryRecord"
      }
    }
  },
  "definitions": {
    "ExamEntryRecord": {
      "type": "object",
      "required": [
        "examEntryId",
        "moduleRegistrationId",
        "examBoardId",
        "statusCode",
        "validFrom",
        "recordedAt"
      ],
      "additionalProperties": false,
      "properties": {
        "examEntryId": {
          "type": "string",
          "format": "uuid",
          "description": "SRS exam entry UUID. Idempotency key for the exam scheduling system."
        },
        "moduleRegistrationId": {
          "type": "string",
          "format": "uuid",
          "description": "SRS module registration UUID."
        },
        "examBoardId": {
          "type": "string",
          "format": "uuid",
          "description": "SRS exam board UUID that generated these entries."
        },
        "candidateNumber": {
          "type": [
            "string",
            "null"
          ],
          "description": "Candidate number assigned by the exam scheduling system. Null until assigned."
        },
        "scheduledDate": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time",
          "description": "ISO 8601 UTC scheduled exam date/time. Null until the timetable is published."
        },
        "roomReference": {
          "type": [
            "string",
            "null"
          ],
          "description": "Exam room reference assigned by the exam scheduling system. Null until timetable is published."
        },
        "statusCode": {
          "type": "string",
          "description": "Exam entry status. Values: 'pending' (submitted, awaiting scheduling), 'scheduled' (candidate number and timetable slot assigned), 'cancelled' (entry withdrawn)."
        },
        "accommodations": {
          "type": "object",
          "description": "The candidate's approved reasonable adjustments for this exam, as at the board's date, and the time they are entitled to. The scheduling system must apply the arrangements marked applied and seat the candidate for totalMinutes. Contains no notes, evidence or diagnosis.",
          "required": [
            "adjustments",
            "extraTimePercent",
            "components"
          ],
          "properties": {
            "adjustments": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "adjustmentId",
                  "distributionId",
                  "adjustmentTypeCode",
                  "scopeCode",
                  "amount",
                  "applied"
                ],
                "properties": {
                  "adjustmentId": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "distributionId": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "format": "uuid",
                    "description": "The 'exams' adjustment distribution this entry delivers."
                  },
                  "adjustmentTypeCode": {
                    "type": "string",
                    "description": "adjustment-type-code value, e.g. extra-time, rest-breaks, separate-room, reader, scribe."
                  },
                  "scopeCode": {
                    "type": "string"
                  },
                  "amount": {
                    "oneOf": [
                      {
                        "type": "null"
                      },
                      {
                        "type": "object",
                        "required": [
                          "value",
                          "unitCode"
                        ],
                        "properties": {
                          "value": {
                            "type": "number"
                          },
                          "unitCode": {
                            "type": "string"
                          }
                        }
                      }
                    ]
                  },
                  "applied": {
                    "type": "boolean",
                    "description": "False when the entry cannot carry it; see reason."
                  },
                  "reason": {
                    "type": "string"
                  }
                }
              }
            },
            "extraTimePercent": {
              "type": "number",
              "description": "Combined additional time from the applied time adjustments (25 = 25%)."
            },
            "components": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "assessmentComponentId",
                  "title",
                  "durationMinutes",
                  "extraMinutes",
                  "totalMinutes"
                ],
                "properties": {
                  "assessmentComponentId": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "title": {
                    "type": "string"
                  },
                  "durationMinutes": {
                    "type": [
                      "integer",
                      "null"
                    ],
                    "description": "Standard duration; null when not recorded."
                  },
                  "extraMinutes": {
                    "type": [
                      "integer",
                      "null"
                    ],
                    "description": "Additional minutes for this candidate, rounded up (120 at 25% = 30)."
                  },
                  "totalMinutes": {
                    "type": [
                      "integer",
                      "null"
                    ],
                    "description": "durationMinutes + extraMinutes (e.g. 150)."
                  }
                }
              }
            }
          },
          "additionalProperties": false
        },
        "validFrom": {
          "type": "string",
          "format": "date-time",
          "description": "ISO 8601 UTC valid-time of this exam entry record."
        },
        "recordedAt": {
          "type": "string",
          "format": "date-time",
          "description": "ISO 8601 UTC transaction time when this entry was recorded in SRS."
        }
      }
    }
  }
}
