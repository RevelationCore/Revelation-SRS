{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://schemas.revelation-srs.io/file-contracts/ukvi/cas-request-outbound/v1.json",
  "title": "UkviCasRequestOutboundV1",
  "description": "Outbound UKVI CAS (Confirmation of Acceptance for Studies) request batch generated by POST /api/v1/regulatory/ukvi/cas-requests/generate. Each entry contains the personal and programme data required by UKVI to assign a CAS reference number. Transmitted to UKVI via the Sponsorship Management System (SMS).",
  "type": "object",
  "required": ["processedCount", "casRequests"],
  "additionalProperties": false,
  "properties": {
    "processedCount": {
      "type": "integer",
      "minimum": 0,
      "description": "Number of CAS request records in this batch."
    },
    "casRequests": {
      "type": "array",
      "description": "CAS request records to transmit to UKVI SMS.",
      "items": { "$ref": "#/definitions/CasRequestRecord" }
    }
  },
  "definitions": {
    "CasRequestRecord": {
      "type": "object",
      "required": ["casRequestId", "enrolmentId", "personData"],
      "additionalProperties": false,
      "properties": {
        "casRequestId": {
          "type": "string",
          "format": "uuid",
          "description": "SRS CAS request UUID. Used to record the UKVI-assigned CAS reference back via PATCH /regulatory/ukvi/cas-requests/{casRequestId}/assignment."
        },
        "enrolmentId": {
          "type": "string",
          "format": "uuid",
          "description": "SRS enrolment UUID."
        },
        "personData": {
          "$ref": "#/definitions/CasPersonData"
        }
      }
    },
    "CasPersonData": {
      "type": "object",
      "required": ["personId", "modeOfStudyCode", "academicYearOfEntry", "startDate"],
      "additionalProperties": false,
      "properties": {
        "personId": {
          "type": "string",
          "format": "uuid",
          "description": "SRS person UUID."
        },
        "legalFirstName": {
          "type": ["string", "null"],
          "description": "Legal given name(s) as on travel document."
        },
        "legalFamilyName": {
          "type": ["string", "null"],
          "description": "Legal family name as on travel document."
        },
        "dateOfBirth": {
          "type": ["string", "null"],
          "format": "date",
          "description": "Date of birth (YYYY-MM-DD)."
        },
        "nationalityCode": {
          "type": ["string", "null"],
          "description": "ISO 3166-1 alpha-2 nationality code, e.g. 'CN', 'IN', 'NG'."
        },
        "programmeId": {
          "type": ["string", "null"],
          "format": "uuid",
          "description": "SRS programme UUID."
        },
        "programmeCode": {
          "type": ["string", "null"],
          "description": "Institution programme code."
        },
        "programmeTitle": {
          "type": ["string", "null"],
          "description": "Full programme title as registered."
        },
        "modeOfStudyCode": {
          "type": "string",
          "description": "Mode of study. Values: 'FT' (full-time), 'PT' (part-time)."
        },
        "academicYearOfEntry": {
          "type": "string",
          "description": "Academic year of entry, e.g. '2025/26'."
        },
        "startDate": {
          "type": "string",
          "format": "date",
          "description": "Programme start date (YYYY-MM-DD)."
        },
        "expectedEndDate": {
          "type": ["string", "null"],
          "format": "date",
          "description": "Expected programme end date (YYYY-MM-DD)."
        }
      }
    }
  }
}
